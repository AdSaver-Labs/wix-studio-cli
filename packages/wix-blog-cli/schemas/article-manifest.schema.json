{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wix Client Article Manifest",
  "type": "object",
  "required": ["articles"],
  "properties": {
    "imagePolicy": {"enum": ["required", "text-only-explicit"]},
    "articles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "language", "title", "slug", "seoTitle", "metaDescription", "focusKeyword", "excerpt", "blocks", "internalLinks", "cta"],
        "properties": {
          "key": {"type": "string", "minLength": 2},
          "language": {"enum": ["bg", "en"]},
          "title": {"type": "string", "minLength": 8},
          "slug": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "seoTitle": {"type": "string", "minLength": 8, "maxLength": 75},
          "metaDescription": {"type": "string", "minLength": 80, "maxLength": 170},
          "focusKeyword": {"type": "string", "minLength": 2},
          "excerpt": {"type": "string", "minLength": 20},
          "sourceNotes": {"type": "array", "items": {"type": "string"}},
          "internalLinks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["url"], "properties": {"url": {"type": "string"}, "anchor": {"type": "string"}, "label": {"type": "string"}}}},
          "cta": {"type": "object", "required": ["url", "label"], "properties": {"url": {"type": "string"}, "label": {"type": "string"}, "heading": {"type": "string"}}},
          "images": {"type": "array", "items": {"type": "object", "required": ["role", "alt"], "properties": {"role": {"type": "string"}, "alt": {"type": "string"}, "wixMedia": {"type": "object"}}}},
          "blocks": {"type": "array", "minItems": 6}
        }
      }
    }
  }
}
